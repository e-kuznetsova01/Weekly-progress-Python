3. Есть два кандидата, определить, кто победил по количеству голосов за каждого (1 - за первого, 2 - за второго, остальное - испорченные бюллетени)
____________________
a = [1, 2, "x...", 1, "против всех", 2, 2, 2]
s1 = 0
s2 = 0
for i in range(0,len(a)):
    try:
        if a[i] == 1:
            s1 = s1 + 1
