import random
def hit(x,y):
    if x>=y:
        print("game over")
        exit()
    else:
        s = random.randint(0,1)
        if s==1:
            print("противник")
            print("скрестить шпаги")
            you = random.randint(1,3)
            input(f"твой удар равен {you}")
            pirate = random.randint(1,3)
            input(f"твой удар равен {pirate}")
            if you>pirate:
                print("победа")
                hit(x+1,y)
            else:
                print("поражение")
                exit()
        else:
            print("незнакомец")
        hit(x+1,y)
